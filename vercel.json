{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'static site: no install'",
  "buildCommand": "echo 'static site: no build'",
  "outputDirectory": "site",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/jumpkey.zip",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment; filename=\"jumpkey.zip\"" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
